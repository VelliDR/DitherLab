// SpiderVerseGlitch.agsl
uniform shader image;
uniform float2 resolution;
uniform float time; // Animasyon veya rastgelelik tohumu (seed)
uniform float glitchAmount;

// Hash/Noise fonksiyonu
float rand(float2 co){
    return fract(sin(dot(co.xy ,float2(12.9898,78.233))) * 43758.5453);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / resolution;
    
    // 1. Block Displacement (Yatay blok kaymaları)
    // Ekranı 30 yatay bloğa böl ve rastgele kaydır
    float block = floor(uv.y * 30.0);
    float shift = (rand(float2(block, time)) - 0.5) * 0.1 * glitchAmount;
    
    // Stuttering: Ara sıra çok şiddetli, keskin blok kaymaları
    if (rand(float2(block, time * 2.0)) > 0.95) {
        shift *= 5.0; // Ağır frame yirtilmasi
    }
    
    float2 shiftedUv = uv + float2(shift, 0.0);
    
    // 2. Chromatic Misregistration (CMYK/RGB kayması - Çizgi roman baskı hatası)
    float2 redUv = shiftedUv + float2(0.01 * glitchAmount, 0.0);
    float2 cyanUv = shiftedUv - float2(0.01 * glitchAmount, 0.0);
    
    half4 colorRed = image.eval(redUv * resolution);
    half4 colorCyan = image.eval(cyanUv * resolution);
    half4 colorCenter = image.eval(shiftedUv * resolution);
    
    // Kanalları ayrıştırıp yeniden birleştir (Magenta/Cyan/Red split)
    half4 finalColor = half4(colorRed.r, colorCyan.g, colorCyan.b, colorCenter.a);
    
    // 3. Halftone Scanlines (İnce dokusal çizgiler)
    float scanline = sin(uv.y * resolution.y * 1.5) * 0.1 * glitchAmount;
    
    // Çizgi roman tarzı kontrastı artırmak için koyultma
    finalColor.rgb -= half3(scanline);
    
    return finalColor;
}
